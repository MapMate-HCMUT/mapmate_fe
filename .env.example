# Copy file này thành .env.local rồi điền key thật (KHÔNG commit .env.local)
# Để trống => bản đồ tự dùng OpenFreeMap (miễn phí, không cần key)
VITE_GOONG_MAPTILES_KEY=
# Key Goong REST (chỉ đường, tìm địa chỉ khi bấm 1 điểm trên bản đồ). Để trống => dùng key dùng chung của nhóm
VITE_GOONG_API_KEY=

# Đăng nhập Google (BẮT BUỘC để đăng nhập): OAuth Client ID loại "Web application" ở
# https://console.cloud.google.com/apis/credentials — thêm http://localhost:5173 vào "Authorized JavaScript origins"
VITE_GOOGLE_CLIENT_ID=

# Địa chỉ backend khi chạy dev (Vite proxy /api -> đây)
VITE_API_PROXY_TARGET=http://localhost:3000
# Khi deploy frontend tách riêng backend: đặt URL đầy đủ, VD https://api.mapmate.vn/api
VITE_API_BASE_URL=/api
